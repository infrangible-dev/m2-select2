{
    "name": "infrangible/m2-select2",
    "description": "Provides the Select2 library for styled, searchable drop-down lists in the Magento storefront and admin, used by other Infrangible modules.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce"
    ],
    "homepage": "https://www.infrangible.dev/modules/select2",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@infrangible.dev",
            "homepage": "https://www.infrangible.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\Select2\\": "src"
        }
    }
}
